# Generate distinct credentials with: node provision.cjs
AI_WATCH_DESKTOP_TOKEN=
# Bootstrap/admin credential only; apps exchange this for an installation token.
AI_WATCH_MOBILE_TOKEN=
AI_WATCH_LOW_QUOTA_PERCENT=20
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
AI_WATCH_TRUST_PROXY=false
# Firebase service-account JSON, mounted read-only; required for Android push.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json
# Apple .p8 signing key and App ID configuration; required for iOS push.
# APNS_KEY_FILE=secrets/apns-auth-key.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=app.aiwatch.mobile
# Live Activities use these same APNs credentials with a .push-type.liveactivity topic suffix.
# OEM credentials and approved scenes: see README.md. Never place server secrets in APKs.
# AI_WATCH_OEM_LOCALE=zh
# MIPUSH_APP_SECRET=
# MIPUSH_PACKAGE_NAME=
# MIPUSH_CHANNEL_ID=
# MIPUSH_TEMPLATE_ID=
# MIPUSH_TEMPLATE_FIELDS={}
# MIPUSH_APPROVED_BUSINESS=
# VIVO_PUSH_APP_ID=
# VIVO_PUSH_APP_KEY=
# VIVO_PUSH_APP_SECRET=
# VIVO_PUSH_CATEGORY=
# VIVO_PUSH_APPROVED_SCENE=
# VIVO_PUSH_ICON_PATH=res/drawable-nodpi-v4/ai_watch_live_icon.png
# VIVO_PUSH_MODE=0
