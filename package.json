{
  "name": "ai-watch-panel",
  "version": "0.19.1",
  "description": "A cross-platform vertical AI activity and quota panel",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "AI Watch contributors",
  "homepage": "https://github.com/Andromedahk/ai-watch-panel",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-native.mjs && tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "test:tray": "node scripts/verify-tray.mjs",
    "pack:mac": "npm run build && electron-builder --mac --dir",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "test:ui": "node scripts/verify-test-mode.mjs",
    "test:skins": "node scripts/verify-skins.mjs",
    "test:motion": "node scripts/verify-motion.mjs",
    "test:insights": "node scripts/verify-insights.mjs",
    "test:corners": "node scripts/verify-corners.mjs",
    "test:sort": "node scripts/verify-sort.mjs",
    "test:theme": "node scripts/verify-theme.mjs",
    "test:modules": "node scripts/verify-modules.mjs",
    "test:credits": "node scripts/verify-credits.mjs",
    "test:plans": "node scripts/verify-plans.mjs",
    "test:anime": "node scripts/verify-anime.mjs",
    "test:kimi-work": "node scripts/verify-kimi-work.mjs",
    "test:live-kimi-zcode": "node scripts/verify-live-kimi-zcode.mjs",
    "test:quotas": "node scripts/verify-codex-quota.mjs",
    "test:i18n": "node scripts/verify-i18n.mjs",
    "test:layouts": "node scripts/verify-layouts.mjs",
    "test:resources": "node scripts/verify-resources.mjs",
    "build:widgets": "node scripts/build-widgets.mjs",
    "pack:mac:widgets": "node scripts/pack-widgets.mjs",
    "test:widgets": "node scripts/verify-widgets.mjs",
    "preview:widgets": "node scripts/preview-widgets.mjs",
    "test:widgets:bundle": "node scripts/verify-widget-bundle.mjs",
    "test:release": "node scripts/verify-release.mjs",
    "test:codex-attention": "node scripts/verify-codex-attention.mjs"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stream-chain": "^4.2.6",
    "stream-json": "^3.7.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/big.js": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "app.aiwatch.panel",
    "productName": "AI Watch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "tests/fixtures/local-status.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/native/bin/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!electron/native/bin/**/*"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "artifactName": "AI-Watch-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "runAfterFinish": false
    }
  }
}
